# ── Database ─────────────────────────────────────────────────────
# SQLite (default, zero-config). For Postgres, also change the
# provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# ── Auth ─────────────────────────────────────────────────────────
# Generate one: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe (optional) ────────────────────────────────────────────
# Leave empty to use the built-in demo payment gateway.
# With keys set, checkout uses real Stripe Checkout (test mode).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
